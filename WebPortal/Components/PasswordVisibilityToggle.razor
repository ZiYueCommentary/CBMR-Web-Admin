<button type="button" class="btn btn-outline-secondary" disabled="@Disabled"
        data-password-toggle="@InputId" data-show-label="@Localizer["ShowPassword"]"
        data-hide-label="@Localizer["HidePassword"]" aria-controls="@InputId"
        aria-label="@Localizer["ShowPassword"]" title="@Localizer["ShowPassword"]">
    <i class="bi bi-eye" aria-hidden="true"></i>
</button>

@code {
    [Parameter, EditorRequired] public string InputId { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
}
