@page "/"

@inject ServerLocation Location
@implements IAsyncDisposable

@* @attribute [Authorize] *@

<PageTitle>@Localizer["Home"]</PageTitle>

<ServerHeartbeat/>

<h1>@Localizer["HelloWorld"]</h1>

<p>@Localizer["Welcome"]</p>

@if (TimeZone is not null)
{
    (string name, string id, string offset, bool isDaylight) = TimeZone.GetDisplayDetails();
    var localizedName = Localizer[isDaylight ? $"TimeZoneDaylightName.{id}" : $"TimeZoneStandardName.{id}"];
    <p>@Localizer["TimeZoneNotice", localizedName.ResourceNotFound ? name : localizedName.Value, id, offset]</p>
}

<p>@Localizer["PortalVersion", PortalVersion]</p>

@if (!string.IsNullOrEmpty(_bindingVersion))
{
    <p>@Localizer["BindingVersion", _bindingVersion]</p>
    @if (!string.Equals(_bindingVersion, PortalVersion, StringComparison.Ordinal))
    {
        <Alert Color="AlertColor.Warning"><Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>@Localizer["VersionMismatch"]</Alert>
    }
}

@if (!string.IsNullOrWhiteSpace(_processPath))
{
    <p>@Localizer["ConnectedServerProcess", Localizer[_isRunning ? "ServerProcessRunning" : "ServerProcessDead"], _processPath]</p>
}

@code {
    [CascadingParameter] private BrowserTimeZone? TimeZone { get; set; }

    private static readonly string PortalVersion = AssemblyVersion.GetVersion(typeof(Home).Assembly);
    private readonly PeriodicTimer _refreshTimer = new(TimeSpan.FromSeconds(3));
    private Task? _refreshTask;
    private string? _processPath;
    private bool _isRunning;
    private string? _bindingVersion;

    protected override void OnInitialized()
    {
        RefreshStatus();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _refreshTask = RefreshStatusAsync();
        }
    }

    private void RefreshStatus()
    {
        _processPath = Location.Path;
        _bindingVersion = Location.Version;
        _isRunning = ServerProcess.IsRunning(_processPath);
    }

    private async Task RefreshStatusAsync()
    {
        while (await _refreshTimer.WaitForNextTickAsync())
        {
            await InvokeAsync(() =>
            {
                RefreshStatus();
                StateHasChanged();
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        _refreshTimer.Dispose();
        if (_refreshTask is not null)
        {
            await _refreshTask;
        }
    }
}