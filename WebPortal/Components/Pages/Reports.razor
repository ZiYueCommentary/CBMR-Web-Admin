@page "/reports"
@attribute [Authorize]

<PageTitle>@Localizer["Reports"]</PageTitle>
<h1>@Localizer["Reports"]</h1>
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button type="button" class="nav-link @(!_handled ? "active" : "")" aria-pressed="@(!_handled)" @onclick="() => _handled = false">@Localizer["ReportPending"]</button></li>
    <li class="nav-item"><button type="button" class="nav-link @(_handled ? "active" : "")" aria-pressed="@_handled" @onclick="() => _handled = true">@Localizer["ReportHandled"]</button></li>
</ul>
<section hidden="@_handled" aria-label="@Localizer["ReportPending"]"><ReportList Handled="false" /></section>
<section hidden="@(!_handled)" aria-label="@Localizer["ReportHandled"]"><ReportList Handled="true" /></section>

@code {
    private bool _handled;
}
