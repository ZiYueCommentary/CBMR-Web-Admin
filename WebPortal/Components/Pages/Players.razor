@page "/players"
@using CbmrWebAdmin.Shared.Requests
@using Serilog

@attribute [Authorize]

<PageTitle>@Localizer["Players"]</PageTitle>

<h1>@Localizer["Players"]</h1>

<p>@Localizer["PlayersOnline"]</p>

@if (_webPlayers == null)
{
    <p>
        <em>@Localizer["Loading"]</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Index</th>
            <th>Name</th>
            <th>SteamID</th>
            <th>Operations</th>
        </tr>
        </thead>
        <tbody>
        @foreach (WebPlayer player in _webPlayers)
        {
            <tr>
                <td>@player.Index</td>
                <td>@player.Name</td>
                <td>@player.SteamId</td>
                <td>
                    <div class="btn-group" role="group">
                        <button type="button"
                                class="btn btn-warning"
                                disabled="@_pendingKicks.Contains(player.SteamId)"
                                @onclick="() => KickPlayerAsync(player)">
                            Kick
                        </button>
                        <button type="button" class="btn btn-warning">Middle</button>
                        <button type="button" class="btn btn-success">Right</button>
                    </div>
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
        <tr>
            <td colspan="4">@Localizer["PlayersInTotal", _webPlayers.Count]</td>
        </tr>
        </tfoot>
    </table>
}

@code {
    private List<WebPlayer>? _webPlayers;
    private readonly HashSet<string> _pendingKicks = [];

    protected override async Task OnInitializedAsync()
    {
        _webPlayers = await ServerBinding.SendAsync<List<WebPlayer>>(PipeMessageType.Players);
    }

    private async Task KickPlayerAsync(WebPlayer player)
    {
        if (!_pendingKicks.Add(player.SteamId))
        {
            return;
        }

        try
        {
            KickPlayerRequest request = new KickPlayerRequest
            {
                Index = player.Index,
                SteamId = player.SteamId
            };
            var response = await ServerBinding.SendAsync<KickPlayerRequest, PipeEnvelope>(PipeMessageType.KickPlayer, request);
            if (response.Kind == PipeEnvelopeKind.Error) Log.Error("Error on kicking player: {}", response.Error);
        }
        finally
        {
            _pendingKicks.Remove(player.SteamId);
        }
    }
}