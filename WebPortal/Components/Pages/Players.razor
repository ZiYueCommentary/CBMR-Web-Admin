@page "/players"
@attribute [Authorize]
@using CbmrWebAdmin.Shared.Requests
@using CbmrWebAdmin.WebPortal.Components.Dialogs
@using Serilog

@* @attribute [Authorize] *@

<PageTitle>@Localizer["Players"]</PageTitle>

<h1>@Localizer["Players"]</h1>

<p>@Localizer["PlayersOnline"]</p>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (_webPlayers == null && _errorMessage is null)
{
    <p>
        <em>@Localizer["Loading"]</em>
    </p>
}
else if (_webPlayers is not null)
{
    <table class="table">
        <thead>
        <tr>
            <th>@Localizer["Index"]</th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["SteamID"]</th>
            <th>@Localizer["Operations"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (WebPlayer player in _webPlayers)
        {
            <tr>
                <td>@player.Index</td>
                <td>@player.Name</td>
                <td>@player.SteamId</td>
                <td>
                    <div class="btn-group" role="group">
                        <BanPlayerModalButton @key="player.SteamId" Player="player"/>
                        <button type="button"
                                class="btn btn-warning"
                                disabled="@_pendingKicks.Contains(player.SteamId)"
                                @onclick="() => KickPlayerAsync(player)">
                            @Localizer["Kick"]
                        </button>
                        <button type="button" class="btn btn-success">Right</button>
                    </div>
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
        <tr>
            <td colspan="4">@Localizer["PlayersInTotal", _webPlayers.Count]</td>
        </tr>
        </tfoot>
    </table>
}

@code {
    private List<WebPlayer>? _webPlayers;
    private string? _errorMessage;
    private readonly HashSet<string> _pendingKicks = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _webPlayers = await ServerBinding.SendAsync<List<WebPlayer>>(PipeMessageType.Players);
        }
        catch (Exception exception)
        {
            Log.Error(exception, "Error loading players");
            _errorMessage = Localizer["PlayersLoadFailed"];
        }
    }

    private async Task KickPlayerAsync(WebPlayer player)
    {
        if (!_pendingKicks.Add(player.SteamId))
        {
            return;
        }

        try
        {
            _errorMessage = null;
            KickPlayerRequest request = new KickPlayerRequest
            {
                Index = player.Index,
                SteamId = player.SteamId
            };
            await ServerBinding.SendAsync(PipeMessageType.KickPlayer, request);
        }
        catch (Exception exception)
        {
            Log.Error(exception, "Error kicking player");
            _errorMessage = Localizer["KickFailed"];
        }
        finally
        {
            _pendingKicks.Remove(player.SteamId);
        }
    }
}
