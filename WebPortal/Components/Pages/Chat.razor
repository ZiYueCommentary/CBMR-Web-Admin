@page "/Chat"
@using CbmrWebAdmin.Shared.Requests
@inject ServerEvents ServerEvents
@inject ILogger<Chat> Logger
@attribute [Authorize]
@implements IAsyncDisposable

<PageTitle>@Localizer["ChatBox"]</PageTitle>

<h1>@Localizer["ChatBox"]</h1>

@if (_outputs is null)
{
    <p>
        <em>@Localizer["Loading"]</em>
    </p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered table-striped">
            <thead>
                <tr>
                    <th scope="col" aria-sort="@(_sortAscending ? "ascending" : "descending")">
                        <button type="button" class="btn btn-link p-0" @onclick="ToggleSort">
                            @Localizer["Time"] @(_sortAscending ? "▲" : "▼")
                        </button>
                    </th>
                    <th scope="col">@Localizer["Player"]</th>
                    <th scope="col">@Localizer["Message"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (WebChat chat in DisplayedMessages)
                {
                    <tr @key="chat">
                        <td><BrowserTimestamp Utc="chat.When" Format="HH:mm:ss" /></td>
                        <td>@chat.PlayerName</td>
                        <td>@chat.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {

    private List<WebChat>? _outputs;
    private readonly CancellationTokenSource _refreshCancellationTokenSource = new();
    private readonly PeriodicTimer _fallbackTimer = new(TimeSpan.FromSeconds(3));
    private CancellationToken _refreshToken;
    private long _lastSequence;
    private Guid _streamId;
    private bool _sortAscending;
    private bool _busy;
    private bool _refreshPending;
    private bool _disposed;

    private IEnumerable<WebChat> DisplayedMessages =>
        _outputs is null ? [] : (_sortAscending ? Enumerable.Reverse(_outputs) : _outputs);

    protected override async Task OnInitializedAsync()
    {
        _refreshToken = _refreshCancellationTokenSource.Token;
        ServerEvents.ChatUpdated += OnChatUpdated;
        await RefreshAsync();
        _ = PollWhenEventsDisconnectedAsync(_refreshToken);
    }

    private void ToggleSort() => _sortAscending = !_sortAscending;

    private void OnChatUpdated()
    {
        if (_disposed) return;
        _ = InvokeAsync(RefreshAsync);
    }

    private async Task PollWhenEventsDisconnectedAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _fallbackTimer.WaitForNextTickAsync(cancellationToken))
            {
                if (!ServerEvents.IsConnected || _outputs is null)
                {
                    await InvokeAsync(RefreshAsync);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshAsync()
    {
        if (_disposed) return;
        if (_busy)
        {
            _refreshPending = true;
            return;
        }

        _busy = true;
        try
        {
            do
            {
                _refreshPending = false;
                await FetchAsync(_refreshToken);
            }
            while (_refreshPending && !_disposed);
        }
        catch (OperationCanceledException) when (_refreshToken.IsCancellationRequested || _disposed)
        {
        }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Could not refresh chat messages.");
        }
        finally
        {
            _busy = false;
        }

        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private async Task FetchAsync(CancellationToken cancellationToken)
    {
        ChatsResponse response = await ServerBinding.SendAsync<ChatsRequest, ChatsResponse>(
            PipeMessageType.Chats,
            new ChatsRequest { AfterSequence = _lastSequence, StreamId = _streamId },
            cancellationToken);
        bool initialLoad = _outputs is null;
        _outputs ??= [];
        if (_streamId != response.StreamId)
        {
            _lastSequence = 0;
            _streamId = response.StreamId;
        }

        if (response.Messages.Count > 0)
        {
            _lastSequence = response.Messages[^1].Sequence;
            response.Messages.Reverse();
            _outputs.InsertRange(0, initialLoad ? response.Messages.Take(30) : response.Messages);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ServerEvents.ChatUpdated -= OnChatUpdated;
        await _refreshCancellationTokenSource.CancelAsync();
        _fallbackTimer.Dispose();
        _refreshCancellationTokenSource.Dispose();
    }

}
