@page "/Chat"
@using CbmrWebAdmin.Shared.Requests
@inject ServerEvents ServerEvents
@inject ILogger<Chat> Logger
@attribute [Authorize]
@implements IAsyncDisposable

<Alert Color="AlertColor.Primary">
    <Icon Name="IconName.InfoCircleFill" class="me-2"></Icon>@Localizer["ChatPerformanceIssue"]</Alert>

<PageTitle>@Localizer["ChatBox"]</PageTitle>

<h1>@Localizer["ChatBox"]</h1>

@if (_outputs is null)
{
    <p>
        <em>@Localizer["Loading"]</em>
    </p>
}
else
{
    <Grid TItem="WebChat"
          @ref="_grid"
          AllowSorting="true"
          Class="table table-hover table-bordered table-striped"
          DataProvider="ChatDataProvider"
          Responsive="true">

        <GridColumns>
            <GridColumn TItem="WebChat" HeaderText="@Localizer["Time"]" SortKeySelector="item => item.When">
                @context.When.ToString("HH:mm:ss")
            </GridColumn>
            <GridColumn TItem="WebChat" HeaderText="@Localizer["Player"]">
                @context.PlayerName
            </GridColumn>
            <GridColumn TItem="WebChat" HeaderText="@Localizer["Message"]">
                @context.Message
            </GridColumn>
        </GridColumns>

    </Grid>

}

@code {

    private List<WebChat>? _outputs;
    private readonly CancellationTokenSource _refreshCancellationTokenSource = new();
    private readonly SemaphoreSlim _refreshLock = new(1, 1);
    private CancellationToken _refreshToken;
    private Grid<WebChat>? _grid;
    private long _lastSequence;
    private Guid _streamId;

    private async Task<GridDataProviderResult<WebChat>> ChatDataProvider(GridDataProviderRequest<WebChat> request)
    {
        return await Task.FromResult(request.ApplyTo(_outputs));
    }

    protected override async Task OnInitializedAsync()
    {
        _refreshToken = _refreshCancellationTokenSource.Token;
        ServerEvents.ChatUpdated += OnChatUpdated;
        await RefreshSafelyAsync();
    }

    private void OnChatUpdated()
    {
        _ = RefreshSafelyAsync();
    }

    private async Task RefreshSafelyAsync()
    {
        try
        {
            await _refreshLock.WaitAsync(_refreshToken);
            try
            {
                await InvokeAsync(async () =>
                {
                    _refreshToken.ThrowIfCancellationRequested();
                    await RefreshAsync(_refreshToken);
                    StateHasChanged();
                });
            }
            finally
            {
                _refreshLock.Release();
            }
        }
        catch (OperationCanceledException) when (_refreshToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Could not refresh chat messages.");
        }
    }

    private async Task RefreshAsync(CancellationToken cancellationToken)
    {
        ChatsResponse response = await ServerBinding.SendAsync<ChatsRequest, ChatsResponse>(
            PipeMessageType.Chats,
            new ChatsRequest { AfterSequence = _lastSequence, StreamId = _streamId },
            cancellationToken);
        bool initialLoad = _outputs is null;
        _outputs ??= [];
        if (_streamId != response.StreamId)
        {
            _lastSequence = 0;
            _streamId = response.StreamId;
        }

        if (response.Messages.Count > 0)
        {
            _lastSequence = response.Messages[^1].Sequence;
            response.Messages.Reverse();
            _outputs.InsertRange(0, initialLoad ? response.Messages.Take(30) : response.Messages);
        }

        if (_grid is not null)
        {
            await _grid.RefreshDataAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        ServerEvents.ChatUpdated -= OnChatUpdated;
        await _refreshCancellationTokenSource.CancelAsync();
        _refreshCancellationTokenSource.Dispose();
    }

}
