@page "/accounts"
@attribute [Authorize]
@using CbmrWebAdmin.WebPortal.Components.Account.Shared
@using CbmrWebAdmin.WebPortal.Data
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Localizer["AccountManagement"]</PageTitle>

@if (_isPrimaryAdmin)
{
    <h1>@Localizer["AccountManagement"]</h1>
    <StatusMessage Message="@_message" IsError="@_hasError"/>

    <div class="mb-3">
        <button type="button" class="btn btn-primary" @onclick="BeginAdd">@Localizer["AddAccount"]</button>
    </div>

    <Modal @ref="_modal" Title="@Localizer[_editingUserId is null ? "AddAccount" : "EditAccount"]" OnHidden="ResetInput">
        <BodyTemplate>
            <EditForm id="account-form" EditContext="_editContext" OnValidSubmit="SaveAccount">
                <DataAnnotationsValidator/>
                <ValidationSummary class="text-danger"/>
                @if (_modalError is not null)
                {
                    <div class="alert alert-danger" role="alert">@_modalError</div>
                }
                <div class="mb-3">
                    <label for="account-name" class="form-label">@Localizer["Username"]</label>
                    <InputText id="account-name" @bind-Value="_input.UserName" class="form-control" autocomplete="off"
                               disabled="@_saving"/>
                    <ValidationMessage For="() => _input.UserName" class="text-danger"/>
                </div>
                <div class="mb-3">
                    <label for="account-password" class="form-label">@Localizer["Password"]</label>
                    <div class="input-group">
                        <InputText id="account-password" type="password" @bind-Value="_input.Password" class="form-control"
                                   autocomplete="new-password" disabled="@_saving"/>
                        <PasswordVisibilityToggle InputId="account-password" Disabled="@_saving"/>
                        <button type="button" class="btn btn-outline-secondary" disabled="@_saving"
                                @onclick="GeneratePassword">@Localizer["GeneratePassword"]</button>
                    </div>
                    <ValidationMessage For="() => _input.Password" class="text-danger"/>
                </div>
                <div>
                    <label for="account-role" class="form-label">@Localizer["AccountRole"]</label>
                    <InputSelect id="account-role" @bind-Value="_input.IsPrimaryAdmin" class="form-select"
                                 disabled="@_saving">
                        <option value="false">@Localizer["RegularAdmin"]</option>
                        <option value="true">@Localizer["MainAdmin"]</option>
                    </InputSelect>
                    <div class="form-text">@Localizer["AccountRoleSignInNotice"]</div>
                </div>
            </EditForm>
        </BodyTemplate>
        <FooterTemplate>
            <button type="button" class="btn btn-secondary" disabled="@_saving"
                    @onclick="HideModal">@Localizer["Cancel"]</button>
            <button type="submit" form="account-form" class="btn btn-primary"
                    disabled="@_saving">@(_editingUserId is null ? Localizer["AddAccount"] : Localizer["Save"])</button>
        </FooterTemplate>
    </Modal>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>@Localizer["Username"]</th>
                <th>@Localizer["AccountRole"]</th>
                <th>@Localizer["Operations"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (ApplicationUser user in _users)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@Localizer[user.IsPrimaryAdmin ? "MainAdmin" : "RegularAdmin"]</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                @onclick="() => BeginEdit(user)">@Localizer["Edit"]</button>
                        <button type="button" class="btn btn-sm btn-outline-danger ms-2"
                                @onclick="() => DeleteAccount(user)">@Localizer["Delete"]</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <h1>@Localizer["AccessDenied"]</h1>
}

@code {
    private AccountInput _input = new();
    private EditContext _editContext = null!;
    private Modal _modal = null!;
    private List<ApplicationUser> _users = [];
    private string? _editingUserId;
    private string? _message;
    private string? _modalError;
    private bool _saving;
    private bool _hasError;
    private bool _isPrimaryAdmin;

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_input);
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        ApplicationUser? currentUser = await UserManager.GetUserAsync(state.User);
        _isPrimaryAdmin = currentUser?.IsPrimaryAdmin == true;
        if (_isPrimaryAdmin)
        {
            await LoadUsers();
        }
    }

    private async Task LoadUsers()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
        _users = await userManager.Users.AsNoTracking().OrderBy(user => user.UserName).ToListAsync();
    }

    private async Task SaveAccount()
    {
        if (_saving) return;
        _saving = true;
        _modalError = null;
        try
        {
            await SaveAccountCore();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveAccountCore()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
        await using var transaction = await db.Database.BeginTransactionAsync();
        if (!_isPrimaryAdmin || !await IsCurrentUserPrimaryAdmin(userManager))
        {
            _modalError = Localizer["AccessDenied"];
            return;
        }

        IdentityResult result;
        if (_editingUserId is null)
        {
            if (string.IsNullOrWhiteSpace(_input.Password))
            {
                _modalError = Localizer["PasswordRequired"];
                return;
            }

            ApplicationUser user = new() { UserName = _input.UserName.Trim(), IsPrimaryAdmin = _input.IsPrimaryAdmin };
            result = await userManager.CreateAsync(user, _input.Password);
        }
        else
        {
            ApplicationUser? user = await userManager.FindByIdAsync(_editingUserId);
            if (user is null)
            {
                _modalError = Localizer["AccountOperationFailed"];
                return;
            }

            bool roleChanged = user.IsPrimaryAdmin != _input.IsPrimaryAdmin;
            if (user.IsPrimaryAdmin && !_input.IsPrimaryAdmin)
            {
                AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                if (user.Id == userManager.GetUserId(state.User))
                {
                    _modalError = Localizer["CannotDemoteSelf"];
                    return;
                }

                if (await userManager.Users.CountAsync(account => account.IsPrimaryAdmin) <= 1)
                {
                    _modalError = Localizer["LastMainAdminRequired"];
                    return;
                }
            }

            user.UserName = _input.UserName.Trim();
            user.IsPrimaryAdmin = _input.IsPrimaryAdmin;
            result = roleChanged
                ? await userManager.UpdateSecurityStampAsync(user)
                : await userManager.UpdateAsync(user);
            if (result.Succeeded && !string.IsNullOrEmpty(_input.Password))
            {
                string token = await userManager.GeneratePasswordResetTokenAsync(user);
                result = await userManager.ResetPasswordAsync(user, token, _input.Password);
            }
        }

        if (!result.Succeeded)
        {
            _modalError = string.Join(" ", result.Errors.Select(error => error.Description));
            return;
        }

        await transaction.CommitAsync();
        string auditDetails = (_input.IsPrimaryAdmin ? "MainAdmin" : "RegularAdmin") +
                              (_editingUserId is not null && !string.IsNullOrEmpty(_input.Password) ? ", password changed" : "");
        await AuditLogger.WriteAsync(_editingUserId is null ? AuditActions.CreateAccount : AuditActions.UpdateAccount,
            _input.UserName.Trim(), auditDetails);
        await _modal.HideAsync();
        await LoadUsers();
        SetMessage(Localizer["AccountSaved"], false);
    }

    private async Task BeginAdd()
    {
        ResetInput();
        _message = null;
        await _modal.ShowAsync();
    }

    private async Task BeginEdit(ApplicationUser user)
    {
        ResetInput();
        _editingUserId = user.Id;
        _input.UserName = user.UserName ?? string.Empty;
        _input.IsPrimaryAdmin = user.IsPrimaryAdmin;
        _message = null;
        await _modal.ShowAsync();
    }

    private async Task HideModal() => await _modal.HideAsync();

    private async Task DeleteAccount(ApplicationUser user)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
        await using var transaction = await db.Database.BeginTransactionAsync();
        if (!_isPrimaryAdmin || !await IsCurrentUserPrimaryAdmin(userManager))
        {
            SetMessage(Localizer["AccountOperationFailed"], true);
            return;
        }

        ApplicationUser? target = await userManager.FindByIdAsync(user.Id);
        if (target is null)
        {
            SetMessage(Localizer["AccountOperationFailed"], true);
            return;
        }

        if (target.IsPrimaryAdmin && await userManager.Users.CountAsync(account => account.IsPrimaryAdmin) <= 1)
        {
            SetMessage(Localizer["LastMainAdminRequired"], true);
            return;
        }

        IdentityResult result = await userManager.DeleteAsync(target);
        if (!result.Succeeded)
        {
            SetMessage(string.Join(" ", result.Errors.Select(error => error.Description)), true);
            return;
        }

        await transaction.CommitAsync();
        await AuditLogger.WriteAsync(AuditActions.DeleteAccount, target.UserName);
        await LoadUsers();
        SetMessage(Localizer["AccountDeleted"], false);
    }

    private async Task<bool> IsCurrentUserPrimaryAdmin(UserManager<ApplicationUser> userManager)
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        ApplicationUser? user = await userManager.GetUserAsync(state.User);
        return user?.IsPrimaryAdmin == true;
    }

    private void ResetInput()
    {
        if (_saving) return;
        _editingUserId = null;
        _modalError = null;
        _input = new AccountInput();
        _editContext = new EditContext(_input);
    }

    private void GeneratePassword()
    {
        _input.Password = IdentitySeeder.GeneratePassword(16);
    }

    private void SetMessage(string message, bool isError)
    {
        _message = message;
        _hasError = isError;
    }

    private sealed class AccountInput
    {
        public bool IsPrimaryAdmin { get; set; }

        [LocalizedRequired("UsernameRequired")]
        [LocalizedStringLength(256, MinimumLength = 1, ResourceKey = "UsernameLength")]
        public string UserName { get; set; } = string.Empty;

        [LocalizedStringLength(128, ResourceKey = "PasswordLength")]
        [OptionalPasswordMinimumLength(6)]
        public string Password { get; set; } = string.Empty;
    }

    private sealed class OptionalPasswordMinimumLengthAttribute(int minimumLength)
        : ValidationAttribute
    {
        protected override ValidationResult? IsValid(object? value, ValidationContext validationContext)
        {
            if (value is not string password || password.Length == 0 || password.Length >= minimumLength)
                return ValidationResult.Success;

            var localizer = validationContext.GetRequiredService<IStringLocalizer<SharedResource>>();
            return new ValidationResult(localizer["PasswordMinimumLength", minimumLength]);
        }
    }

}