@page "/Error"
@using System.Diagnostics

<PageTitle>@Localizer["Error"]</PageTitle>

<h1 class="text-danger">@Localizer["ErrorHeading"]</h1>
<h2 class="text-danger">@Localizer["RequestProcessingError"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Localizer["RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Localizer["DevelopmentMode"]</h3>
<p>
    @Localizer["DevelopmentModeDescription"]
</p>
<p>
    <strong>@Localizer["DevelopmentWarning"]</strong>
    @Localizer["DevelopmentWarningDetails"]
</p>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

}