@page "/audit-log"
@attribute [Authorize]
@using CbmrWebAdmin.WebPortal.Data
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Localizer["AuditLog"]</PageTitle>

<h1>@Localizer["AuditLog"]</h1>

<p>@Localizer["AuditLogDescription"] <span class="text-muted">(@TimeZoneInfo.Local.DisplayName)</span></p>

<Grid TItem="AuditLogEntry"
      Class="table table-hover table-bordered table-striped"
      DataProvider="AuditLogDataProvider"
      AllowPaging="true"
      PageSize="50"
      Responsive="true">
    <GridColumns>
        <GridColumn TItem="AuditLogEntry" HeaderText="@Localizer["Time"]">
            @DateTime.SpecifyKind(context.TimestampUtc, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
        </GridColumn>
        <GridColumn TItem="AuditLogEntry" HeaderText="@Localizer["Username"]">
            @context.UserName
        </GridColumn>
        <GridColumn TItem="AuditLogEntry" HeaderText="@Localizer["AuditAction"]">
            @Localizer["AuditAction" + context.Action]
        </GridColumn>
        <GridColumn TItem="AuditLogEntry" HeaderText="@Localizer["AuditTarget"]">
            @context.Target
        </GridColumn>
        <GridColumn TItem="AuditLogEntry" HeaderText="@Localizer["AuditDetails"]">
            <span style="white-space: pre-wrap">@context.Details</span>
        </GridColumn>
    </GridColumns>
</Grid>

@code {
    private async Task<GridDataProviderResult<AuditLogEntry>> AuditLogDataProvider(GridDataProviderRequest<AuditLogEntry> request)
    {
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        ApplicationDbContext dbContext = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
        IQueryable<AuditLogEntry> query = dbContext.AuditLogs.AsNoTracking().OrderByDescending(entry => entry.Id);
        int totalCount = await query.CountAsync(request.CancellationToken);
        List<AuditLogEntry> entries = await query
            .Skip((request.PageNumber - 1) * request.PageSize)
            .Take(request.PageSize)
            .ToListAsync(request.CancellationToken);
        return new GridDataProviderResult<AuditLogEntry> { Data = entries, TotalCount = totalCount };
    }
}
