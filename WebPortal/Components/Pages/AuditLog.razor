@page "/audit-log"
@attribute [Authorize]
@using System.Globalization
@using System.Text.RegularExpressions
@using CbmrWebAdmin.WebPortal.Data
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Localizer["AuditLog"]</PageTitle>

<h1>@Localizer["AuditLog"]</h1>

<p>@Localizer["AuditLogDescription"] @if (TimeZone is not null) { <span class="text-muted">(@TimeZone.Id)</span> }</p>

<Grid TItem="AuditLogEntry"
      Class="table table-hover table-bordered table-striped"
      DataProvider="AuditLogDataProvider"
      AllowPaging="true"
      PageSize="50"
      Responsive="true">
    <GridColumns>
        <GridColumn TItem="AuditLogEntry" HeaderText="@Localizer["Time"]">
            <BrowserTimestamp Utc="context.TimestampUtc" />
        </GridColumn>
        <GridColumn TItem="AuditLogEntry" HeaderText="@Localizer["Username"]">
            @context.UserName
        </GridColumn>
        <GridColumn TItem="AuditLogEntry" HeaderText="@Localizer["AuditAction"]">
            @Localizer["AuditAction" + context.Action]
        </GridColumn>
        <GridColumn TItem="AuditLogEntry" HeaderText="@Localizer["AuditTarget"]">
            @context.Target
        </GridColumn>
        <GridColumn TItem="AuditLogEntry" HeaderText="@Localizer["AuditDetails"]">
            @if (context.Details is { } details && GetExpiryField(context) is { } field &&
                 DateTime.TryParseExact(field.Value, "u", CultureInfo.InvariantCulture,
                     DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out DateTime expiryUtc))
            {
                <span style="white-space: pre-wrap">@(details[..field.Index])<BrowserTimestamp Utc="expiryUtc" />@(details[(field.Index + field.Length)..])</span>
            }
            else
            {
                <span style="white-space: pre-wrap">@context.Details</span>
            }
        </GridColumn>
    </GridColumns>
</Grid>

@code {
    [CascadingParameter] private BrowserTimeZone? TimeZone { get; set; }

    private static Group? GetExpiryField(AuditLogEntry entry)
    {
        if (entry.Details is null) return null;
        const string expiry = @"until (?<expiry>[0-9\-: ]{19}Z)";
        string? pattern = entry.Action switch
        {
            AuditActions.BanPlayer or AuditActions.MuteVoice or AuditActions.MuteChat => @"\A" + expiry + ": ",
            AuditActions.ModifyBan => @"\ARecord [0-9]+; " + expiry + ": ",
            AuditActions.ModifyMute => @"\ARecord [0-9]+; (?:Voice|Chat); " + expiry + ": ",
            AuditActions.CreateAnnouncement or AuditActions.UpdateAnnouncement =>
                "; " + expiry + @"; revision [0-9]+; resend: (?:True|False)\z",
            _ => null
        };
        if (pattern is null) return null;

        Match match = Regex.Match(entry.Details, pattern);
        return match.Success ? match.Groups["expiry"] : null;
    }

    private async Task<GridDataProviderResult<AuditLogEntry>> AuditLogDataProvider(GridDataProviderRequest<AuditLogEntry> request)
    {
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        ApplicationDbContext dbContext = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
        IQueryable<AuditLogEntry> query = dbContext.AuditLogs.AsNoTracking().OrderByDescending(entry => entry.Id);
        int totalCount = await query.CountAsync(request.CancellationToken);
        List<AuditLogEntry> entries = await query
            .Skip((request.PageNumber - 1) * request.PageSize)
            .Take(request.PageSize)
            .ToListAsync(request.CancellationToken);
        return new GridDataProviderResult<AuditLogEntry> { Data = entries, TotalCount = totalCount };
    }
}
