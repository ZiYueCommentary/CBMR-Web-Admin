@page "/weather"
@using CbmrWebAdmin.Shared

<PageTitle>Players</PageTitle>

<h1>Player List</h1>

<p>This component demonstrates showing data.</p>

@if (_webPlayers == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Index</th>
            <th>Name</th>
            <th>SteamID</th>
        </tr>
        </thead>
        <tbody>
        @foreach (WebPlayer player in _webPlayers)
        {
            <tr>
                <td>@player.Index</td>
                <td>@player.Name</td>
                <td>@player.SteamId</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<WebPlayer>? _webPlayers;

    protected override async Task OnInitializedAsync()
    {
        _webPlayers = await ServerBinding.SendAsync<List<WebPlayer>>(PipeMessageType.Players);
    }
}