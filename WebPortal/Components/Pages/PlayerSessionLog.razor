@page "/join-leave-log"
@attribute [Authorize]
@using CbmrWebAdmin.Shared.Requests
@inject ILogger<PlayerSessionLog> Logger

<PageTitle>@Localizer["PlayerSessionLog"]</PageTitle>

<h1>@Localizer["PlayerSessionLog"]</h1>
<p>@Localizer["PlayerSessionLogDescription"]</p>

<TableFilterForm OnSubmit="SearchAsync" SubmitText="@Localizer["PlayerSessionLogSearch"]" SubmitDisabled="@(_loading || InvalidDateRange)">
    <Fields>
        <div class="col">
            <label for="player-session-search" class="form-label">@Localizer["PlayerSessionLogSearchLabel"]</label>
            <input id="player-session-search" class="form-control" type="search" @bind="_searchInput" @bind:event="oninput" />
        </div>
        <div class="col">
            <label for="player-session-event" class="form-label">@Localizer["PlayerSessionLogEvent"]</label>
            <select id="player-session-event" class="form-select" @bind="_eventInput">
                <option value="">@Localizer["PlayerSessionLogAllEvents"]</option>
                <option value="@PlayerSessionEvent.Join">@Localizer["PlayerSessionLogJoin"]</option>
                <option value="@PlayerSessionEvent.Leave">@Localizer["PlayerSessionLogLeave"]</option>
            </select>
        </div>
        <div class="col">
            <label for="player-session-from" class="form-label">@Localizer["PlayerSessionLogFromDate"]</label>
            <input id="player-session-from" class="form-control" type="date" @bind="_fromDateInput"
                   min="0001-01-01" max="9999-12-31" disabled="@(TimeZone is null)" />
        </div>
        <div class="col">
            <label for="player-session-through" class="form-label">@Localizer["PlayerSessionLogThroughDate"]</label>
            <input id="player-session-through" class="form-control" type="date" @bind="_throughDateInput"
                   min="0001-01-01" max="9999-12-31" disabled="@(TimeZone is null)" />
        </div>
    </Fields>
</TableFilterForm>

@if (InvalidDateRange)
{
    <p class="text-danger" role="alert">@Localizer["PlayerSessionLogInvalidDateRange"]</p>
}

@if (_loading)
{
    <p><em>@Localizer["Loading"]</em></p>
}
else if (_page is null)
{
    <div class="alert alert-danger" role="alert">@Localizer["PlayerSessionLogLoadFailed"]</div>
}
else if (_page.Records.Count == 0)
{
    <p>@Localizer["PlayerSessionLogEmpty"]</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped" aria-label="@Localizer["PlayerSessionLog"]">
            <thead>
                <tr>
                    @foreach ((PlayerSessionLogSortColumn column, string label) in SortColumns)
                    {
                        <th scope="col" aria-sort="@(_sortColumn == column ? (_sortAscending ? "ascending" : "descending") : null)">
                            <button type="button" class="btn btn-link p-0 fw-bold text-reset text-nowrap" @onclick="() => SortAsync(column)">
                                @Localizer[label]<span aria-hidden="true">@SortIndicator(column)</span>
                            </button>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (PlayerSessionRecord record in _page.Records)
                {
                    <tr>
                        <td><BrowserTimestamp Utc="record.OccurredAtUtc" /></td>
                        <td>@Localizer[record.Event == PlayerSessionEvent.Join ? "PlayerSessionLogJoin" : "PlayerSessionLogLeave"]</td>
                        <td>@record.SteamId</td>
                        <td style="white-space: pre-wrap">@record.Name</td>
                        <td>@record.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <nav class="d-flex align-items-center gap-2" aria-label="@Localizer["PlayerSessionLogPagination"]">
        <button type="button" class="btn btn-secondary" disabled="@(PageNumber == 1)" @onclick="() => LoadAsync(_offset - PageSize)">
            @Localizer["PlayerSessionLogPrevious"]
        </button>
        <span>@Localizer["PlayerSessionLogPage", PageNumber, PageCount]</span>
        <button type="button" class="btn btn-secondary" disabled="@(PageNumber >= PageCount)" @onclick="() => LoadAsync(_offset + PageSize)">
            @Localizer["PlayerSessionLogNext"]
        </button>
    </nav>
}

@code {
    [CascadingParameter] private BrowserTimeZone? TimeZone { get; set; }

    private const int PageSize = 50;
    private static readonly (PlayerSessionLogSortColumn Column, string Label)[] SortColumns =
    [
        (PlayerSessionLogSortColumn.Time, "Time"),
        (PlayerSessionLogSortColumn.Event, "PlayerSessionLogEvent"),
        (PlayerSessionLogSortColumn.SteamId, "SteamID"),
        (PlayerSessionLogSortColumn.Name, "Name"),
        (PlayerSessionLogSortColumn.IpAddress, "PlayerSessionLogIpAddress")
    ];

    private string _searchInput = string.Empty;
    private string _search = string.Empty;
    private DateOnly? _fromDateInput;
    private DateOnly? _throughDateInput;
    private DateTime? _fromUtc;
    private DateTime? _beforeUtc;
    private PlayerSessionEvent? _eventInput;
    private PlayerSessionEvent? _event;
    private PlayerSessionLogSortColumn _sortColumn = PlayerSessionLogSortColumn.Time;
    private bool _sortAscending;
    private int _offset;
    private bool _loading;
    private PlayerSessionLogResponse? _page;

    private bool InvalidDateRange => _fromDateInput > _throughDateInput;
    private int PageNumber => _offset / PageSize + 1;
    private int PageCount => _page?.TotalCount is > 0 and var count ? (count - 1) / PageSize + 1 : 0;

    protected override Task OnInitializedAsync() => LoadAsync(0);

    private Task SearchAsync()
    {
        if (_loading || InvalidDateRange) return Task.CompletedTask;

        _search = _searchInput;
        _event = _eventInput;
        _fromUtc = _fromDateInput is { } from ? TimeZone?.StartOfDayUtc(from) : null;
        _beforeUtc = _throughDateInput is { } through && through < DateOnly.MaxValue
            ? TimeZone?.StartOfDayUtc(through.AddDays(1))
            : null;
        return LoadAsync(0);
    }

    private string SortIndicator(PlayerSessionLogSortColumn column) =>
        _sortColumn == column ? (_sortAscending ? " ↑" : " ↓") : " ↕";

    private Task SortAsync(PlayerSessionLogSortColumn column)
    {
        if (_loading) return Task.CompletedTask;

        _sortAscending = _sortColumn == column ? !_sortAscending : column != PlayerSessionLogSortColumn.Time;
        _sortColumn = column;
        return LoadAsync(0);
    }

    private async Task LoadAsync(int offset)
    {
        if (_loading) return;
        _loading = true;
        try
        {
            _page = await ServerBinding.SendAsync<PlayerSessionLogRequest, PlayerSessionLogResponse>(
                PipeMessageType.QueryPlayerSessionLog,
                new PlayerSessionLogRequest
                {
                    Search = _search,
                    Offset = offset,
                    PageSize = PageSize,
                    FromUtc = _fromUtc,
                    BeforeUtc = _beforeUtc,
                    Event = _event,
                    SortColumn = _sortColumn,
                    SortAscending = _sortAscending
                });
            _offset = offset;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Error loading the join-leave log");
            _page = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
