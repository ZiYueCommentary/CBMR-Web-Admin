@page "/central-console"
@attribute [Authorize]
@using CbmrWebAdmin.WebPortal.Components.Dialogs
@using CbmrWebAdmin.Shared.Requests
@using System.Globalization
@using CbmrWebAdmin.WebPortal.Data

<PageTitle>@Localizer["CentralConsole"]</PageTitle>

<ServerHeartbeat/>

<h1>@Localizer["CentralConsole"]</h1>

<div class="console-groups">
    <fieldset class="console-group">
        <legend>@Localizer["PlayerCommunication"]</legend>
        <div class="console-language-setting d-flex align-items-center gap-2 mb-2">
            <label for="player-language" class="mb-0">@Localizer["PlayerLanguage"]</label>
            <select @key="_languageBusy" id="player-language" class="form-select" value="@_playerLanguage" @onchange="SetPlayerLanguage" disabled="@_languageBusy">
                @if (_playerLanguage is null)
                {
                    <option value="">@(_languageBusy ? Localizer["Loading"] : Localizer["SelectPlayerLanguage"])</option>
                }
                @foreach (string culture in PlayerLanguages.Supported)
                {
                    <option value="@culture">@CultureInfo.GetCultureInfo(culture).NativeName</option>
                }
            </select>
        </div>
        <BroadcastModalButton/>
    </fieldset>

    <fieldset class="console-group">
        <legend>@Localizer["MapMaintenance"]</legend>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" disabled="@_maintenanceInProgress.Contains(PipeMessageType.FixElevator)"
                    @onclick='() => RunMaintenanceAsync(PipeMessageType.FixElevator, AuditActions.FixElevator, "ElevatorOpened", "FixElevatorFailed")'>
                @Localizer["FixElevator"]
            </button>
            <button class="btn btn-primary" disabled="@_maintenanceInProgress.Contains(PipeMessageType.ClearItems)"
                    @onclick='() => RunMaintenanceAsync(PipeMessageType.ClearItems, AuditActions.ClearItems, "ItemsCleared", "ClearItemsFailed")'>
                @Localizer["ClearItems"]
            </button>
        </div>
    </fieldset>

    <fieldset class="console-group">
        <legend>@Localizer["PlayerModeration"]</legend>
        <div class="d-flex flex-wrap gap-2">
            <BanPlayerModalButton/>
            <MutePlayerModalButton/>
        </div>
    </fieldset>

    <fieldset class="console-group">
        <legend>@Localizer["DangerZone"]</legend>
        <div class="d-flex flex-wrap gap-2">
            <RestartServerModalButton/>
            <ForceRestartServerButton/>
        </div>
    </fieldset>
</div>

@code {
    private string? _playerLanguage;
    private bool _languageBusy;
    private readonly HashSet<PipeMessageType> _maintenanceInProgress = [];

    protected override async Task OnInitializedAsync()
    {
        _languageBusy = true;
        try
        {
            _playerLanguage = await ServerBinding.SendAsync<string>(PipeMessageType.GetPlayerLanguage);
        }
        catch (Exception)
        {
            ToastService.Notify(new(ToastType.Danger, Localizer["PlayerLanguageFailed"]));
        }
        finally
        {
            _languageBusy = false;
        }
    }

    private async Task SetPlayerLanguage(ChangeEventArgs args)
    {
        string? culture = args.Value?.ToString();
        if (culture is null || !PlayerLanguages.Supported.Contains(culture)) return;
        _languageBusy = true;
        try
        {
            await ServerBinding.SendAsync(PipeMessageType.SetPlayerLanguage, new SetPlayerLanguageRequest { Culture = culture });
            _playerLanguage = culture;
            await AuditLogger.WriteAsync(AuditActions.SetPlayerLanguage, details: culture);
            ToastService.Notify(new(ToastType.Success, Localizer["PlayerLanguageSaved"]));
        }
        catch (Exception)
        {
            ToastService.Notify(new(ToastType.Danger, Localizer["PlayerLanguageFailed"]));
        }
        finally
        {
            _languageBusy = false;
        }
    }

    private async Task RunMaintenanceAsync(PipeMessageType messageType, string auditAction, string successKey, string errorKey)
    {
        if (!_maintenanceInProgress.Add(messageType)) return;
        try
        {
            await ServerBinding.SendAsync(messageType);
            await AuditLogger.WriteAsync(auditAction);
            ToastService.Notify(new(ToastType.Success, Localizer[successKey]));
        }
        catch (Exception)
        {
            ToastService.Notify(new(ToastType.Danger, Localizer[errorKey]));
        }
        finally
        {
            _maintenanceInProgress.Remove(messageType);
        }
    }
}