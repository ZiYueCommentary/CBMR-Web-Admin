@page "/central-console"
@using CbmrWebAdmin.WebPortal.Components.Dialogs

<PageTitle>@Localizer["CentralConsole"]</PageTitle>

<h1>@Localizer["CentralConsole"]</h1>

<button class="btn btn-primary" @onclick="FixElevator">@Localizer["FixElevator"]</button>
<BroadcastModalButton/>
<button class="btn btn-primary" @onclick="ClearItems">@Localizer["ClearItems"]</button>

@code {
    private async Task FixElevator()
    {
        await ServerBinding.SendAsync(PipeMessageType.FixElevator);
        ToastService.Notify(new(ToastType.Success, "Elevators at Gate A and B has been opened."));
    }
    
    private async Task ClearItems()
    {
        await ServerBinding.SendAsync(PipeMessageType.ClearItems);
        ToastService.Notify(new(ToastType.Success, "All items not picked has been cleared."));
    }
}