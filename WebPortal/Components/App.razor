@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["CbmrWebAdmin.WebPortal.styles.css"]"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/gh/vikramlearning/blazorbootstrap@v3.5.0/blazorbootstrap/wwwroot/blazor.bootstrap.css" rel="stylesheet" integrity="sha384-uHNrBicU1rk5KBSLEJGUQ5ZkvEjLrkerU1lp1NgSSn2qzlkcjBWD/ULydjuvpXH8" crossorigin="anonymous">
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet @rendermode="PageRenderMode"/>
</head>

<body>
<Routes @rendermode="PageRenderMode"/>
<script src="@Assets["browser-time-zone.js"]"></script>
<script src="@Assets["password-visibility.js"]"></script>
<script src="_framework/blazor.web.js"></script>
<script src="report-notifications.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/gh/vikramlearning/blazorbootstrap@v3.5.0/blazorbootstrap/wwwroot/blazor.bootstrap.js" integrity="sha384-d8RzcjpCYsv4SjxkWdVtS2gw1nqNHAYN/GUszoYPK5Nww66YKXhdzsVNQg7r0Kn+" crossorigin="anonymous"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

}
