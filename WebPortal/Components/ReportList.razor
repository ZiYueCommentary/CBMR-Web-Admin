@using CbmrWebAdmin.Shared.Requests
@implements IDisposable
@inject ServerEvents Events

<p>@Localizer["ReportListDescription"] @if (TimeZone is not null) { <span>(@TimeZone.Id)</span> }</p>
<form @onsubmit="ApplyAsync" @onsubmit:preventDefault class="row g-3 mb-3">
<div class="col-md-3"><label for="@(_id + "-from")">@Localizer["AuditFrom"]</label>
<input id="@(_id + "-from")" class="form-control" type="datetime-local" @bind="_from" disabled="@(TimeZone is null)" /></div>
<div class="col-md-3"><label for="@(_id + "-to")">@Localizer["AuditTo"]</label>
<input id="@(_id + "-to")" class="form-control" type="datetime-local" @bind="_to" disabled="@(TimeZone is null)" /></div>
<div class="col-md-3"><label for="@(_id + "-reporter")">@Localizer["ReportFilterReporter"]</label>
<input id="@(_id + "-reporter")" class="form-control" type="search" @bind="_reporter"  /></div>
<div class="col-md-3"><label for="@(_id + "-player")">@Localizer["ReportFilterPlayer"]</label>
<input id="@(_id + "-player")" class="form-control" type="search" @bind="_player"  /></div>
<div class="col-md-3"><label for="@(_id + "-content")">@Localizer["ReportContent"]</label>
<input id="@(_id + "-content")" class="form-control" type="search" @bind="_content"  /></div>
<div class="col-md-3"><label for="@(_id + "-size")">@Localizer["AuditPageSize"]</label>
<select id="@(_id + "-size")" class="form-select" @bind="_pageSize">
@foreach (int size in new[] { 10, 25, 50, 100 }) { <option value="@size">@size</option> }
</select></div>
<div class="col-md-3 align-self-end"><button type="submit" class="btn btn-primary" disabled="@_busy">@Localizer["AuditApply"]</button>
<button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="RefreshAsync">@Localizer["Reload"]</button></div>
</form>
<p aria-live="polite">@Localizer["AuditTotal", _total]</p>
@if (_error is not null)
{
    <div class="alert alert-danger">@Localizer[_error]</div>
    <button class="btn btn-secondary" @onclick="RefreshAsync">@Localizer["Reload"]</button>
}
@if (_reports is null)
{
    <p>@Localizer["Loading"]</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead><tr>
@foreach (var column in Columns)
{
<th scope="col" aria-sort="@(_sort == column.Key ? (_ascending ? "ascending" : "descending") : "none")">
<button type="button" class="btn btn-link p-0" disabled="@_busy" @onclick="() => SortAsync(column.Key)">@Localizer[column.Label] @(_sort == column.Key ? (_ascending ? "▲" : "▼") : "")</button>
</th>
}
<th scope="col">@Localizer["ReportStatus"]</th><th scope="col">@Localizer["ReportReply"]</th><th scope="col">@Localizer["ReportActions"]</th>
</tr></thead>
            <tbody>
            @foreach (var report in _reports)
            {
                <tr @key="report.Id">
                    <td><BrowserTimestamp Utc="report.CreatedAtUtc" Format="g" /></td>
                    <td>@report.ReporterName<br/><small>@report.ReporterSteamId</small></td>
                    <td>@report.ReportedName<br/><small>@report.ReportedSteamId</small></td>
                    <td style="white-space: pre-wrap">@report.Content</td>
                    <td>@Localizer[report.Handled ? "ReportHandled" : "ReportPending"]
                        @if (report.Accepted is { } accepted)
                        {
                            <span class="badge @(accepted ? "bg-success" : "bg-danger")">@Localizer[accepted ? "ReportAccepted" : "ReportRejected"]</span>
                        }
                    </td>
                    <td style="white-space: pre-wrap">@report.Reply
                        @if (report.Handled) { <div><small>@report.RepliedBy · <BrowserTimestamp Utc="report.HandledAtUtc" Format="g" /></small></div> }
                        @if (report.Handled)
                        {
                            <div><small>@Localizer[report.ReplyDeliveredAtUtc is null ? "ReportReplyPendingDelivery" : "ReportReplyDelivered"]
                                <BrowserTimestamp Utc="report.ReplyDeliveredAtUtc" Format="g" /></small></div>
                        }
                    </td>
                    <td><CbmrWebAdmin.WebPortal.Components.Dialogs.ReplyReportModalButton Report="report" OnReplied="RefreshAsync" /></td>
                </tr>
            }
            </tbody>
        </table>
        @if (_reports.Count == 0) { <p>@Localizer["NoReports"]</p> }
    </div>
}

<nav aria-label="@Localizer["ReportListPages"]" class="d-flex gap-2 flex-wrap">
<button class="btn btn-secondary" disabled="@(_busy || _page <= 1)" @onclick="() => LoadAsync(_page - 1)">@Localizer["AuditPrevious"]</button>
@for (int number = Math.Max(1, _page - 2); number <= Math.Min(PageCount, _page + 2); number++)
{
int page = number;
<button class="btn @(page == _page ? "btn-primary" : "btn-outline-primary")" aria-current="@(page == _page ? "page" : null)" disabled="@_busy" @onclick="() => LoadAsync(page)">@(page)</button>
}
<button class="btn btn-secondary" disabled="@(_busy || _page >= PageCount)" @onclick="() => LoadAsync(_page + 1)">@Localizer["AuditNext"]</button>
</nav>
@code {
    [Parameter] public bool Handled { get; set; }
    [CascadingParameter] private BrowserTimeZone? TimeZone { get; set; }
    private readonly string _id = "reports-" + Guid.NewGuid().ToString("N");
    private static readonly (ReportSortColumn Key, string Label)[] Columns =
    [
        (ReportSortColumn.Time, "Time"), (ReportSortColumn.Reporter, "Reporter"),
        (ReportSortColumn.ReportedPlayer, "ReportedPlayer"), (ReportSortColumn.Content, "ReportContent")
    ];
    private DateTime? _from, _to, _fromUtc, _toUtc;
    private string _reporter = "", _player = "", _content = "";
    private string _appliedReporter = "", _appliedPlayer = "", _appliedContent = "";
    private ReportSortColumn _sort;
    private bool _ascending, _busy, _refreshPending, _disposed;
    private int _page = 1, _pageSize = 50, _appliedSize = 50, _total;
    private int PageCount => Math.Max(1, (int)Math.Ceiling((double)_total / _appliedSize));
    private List<ReportRecord>? _reports;
    private string? _error;
    private readonly CancellationTokenSource _cancellation = new();
    protected override async Task OnInitializedAsync()
    {
        Events.ReportsUpdated += OnUpdated;
        await RefreshAsync();
    }
    private void OnUpdated(ReportRecord? report) => _ = InvokeAsync(RefreshAsync);
    private async Task ApplyAsync()
    {
        if (_busy) return;
        DateTime? from = _from.HasValue ? TimeZone?.ToUtc(_from.Value) : null;
        DateTime? to = _to.HasValue ? TimeZone?.ToUtc(_to.Value) : null;
        if ((_from.HasValue && !from.HasValue) || (_to.HasValue && !to.HasValue) || from > to)
        {
            _error = "AuditInvalidRange";
            return;
        }
        _fromUtc = from;
        _toUtc = to;
        _appliedReporter = _reporter.Trim();
        _appliedPlayer = _player.Trim();
        _appliedContent = _content.Trim();
        _appliedSize = _pageSize;
        await LoadAsync(1);
    }
    private async Task SortAsync(ReportSortColumn column)
    {
        if (_busy) return;
        _ascending = _sort == column ? !_ascending : true;
        _sort = column;
        await LoadAsync(1);
    }
    private Task<ReportListResponse> QueryAsync(int page) =>
        ServerBinding.SendAsync<ReportListRequest, ReportListResponse>(PipeMessageType.QueryReports, new ReportListRequest
        {
            Offset = (page - 1) * _appliedSize, PageSize = _appliedSize, Handled = Handled,
            FromUtc = _fromUtc, ToUtc = _toUtc, Reporter = _appliedReporter,
            ReportedPlayer = _appliedPlayer, Content = _appliedContent, SortColumn = _sort, SortAscending = _ascending
        }, _cancellation.Token);
    private Task RefreshAsync()
    {
        if (_busy) { _refreshPending = true; return Task.CompletedTask; }
        return LoadAsync(_page);
    }
    private async Task LoadAsync(int page)
    {
        if (_disposed || _busy) return;
        _busy = true;
        _error = null;
        try
        {
            ReportListResponse result = await QueryAsync(page);
            if (_disposed) return;
            _total = result.TotalCount;
            _page = Math.Clamp(page, 1, PageCount);
            if (_page != page) result = await QueryAsync(_page);
            if (_disposed) return;
            _reports = result.Records;
            _total = result.TotalCount;
        }
        catch (OperationCanceledException) when (_disposed) { return; }
        catch { _reports = []; _total = 0; _page = 1; _error = "ReportsLoadFailed"; }
        finally { _busy = false; }
        if (_refreshPending && !_disposed)
        {
            _refreshPending = false;
            await RefreshAsync();
        }
        if (!_disposed) StateHasChanged();
    }
    public void Dispose()
    {
        _disposed = true;
        Events.ReportsUpdated -= OnUpdated;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
