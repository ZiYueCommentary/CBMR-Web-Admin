@using CbmrWebAdmin.Shared.Requests
@using CbmrWebAdmin.WebPortal.Components.Dialogs
@using CbmrWebAdmin.WebPortal.Data
@using Serilog

<button type="button" class="btn btn-secondary mb-3" disabled="@_busy" @onclick="LoadAsync">@Localizer["ModerationRefresh"]</button>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
@if (_loading)
{
    <p><em>@Localizer["Loading"]</em></p>
}
else if (_records is not null)
{
    @if (_records.Count == 0)
    {
        <p>@Localizer[Expired ? "NoExpiredModeration" : "NoActiveModeration"]</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                <tr>
                    <th>@Localizer["ModerationId"]</th>
                    <th>@Localizer["SteamID"]</th>
                    <th>@Localizer["MuteKind"]</th>
                    <th>@Localizer["ModerationReason"]</th>
                    <th>@Localizer["ModerationStartedAt"]</th>
                    <th>@Localizer["ModerationExpiresAt"]</th>
                    <th>@Localizer["Operations"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (MuteRecord row in _records)
                {
                    <tr @key="row.Id">
                        <td>@row.Id</td>
                        <td>@row.SteamId</td>
                        <td>@Localizer[row.Kind == MuteRecordKind.Voice ? "MuteKindVoice" : "MuteKindChat"]</td>
                        <td style="white-space: pre-wrap">@row.Reason</td>
                        <td><BrowserTimestamp Utc="row.StartedAtUtc" /></td>
                        <td>
                            @if (row.ExpiresAtUtc is { } expiry)
                            {
                                <BrowserTimestamp Utc="expiry" />
                            }
                            else
                            {
                                @Localizer["ModerationPermanent"]
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-danger" disabled="@_busy" @onclick="() => RemoveAsync(row)">@Localizer["Unmute"]</button>
                                <ModifyModerationModalButton Id="row.Id" SteamId="@row.SteamId" Reason="@row.Reason"
                                    ExpiresAtUtc="row.ExpiresAtUtc" IsMute="true" Kind="row.Kind" Disabled="_busy" OnSaved="LoadAsync" />
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public bool Expired { get; set; }

    private List<MuteRecord>? _records;
    private bool _loading = true;
    private bool _busy;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        _loading = true;
        _errorMessage = null;
        try
        {
            _records = await ServerBinding.SendAsync<List<MuteRecord>>(
                Expired ? PipeMessageType.ListExpiredMutes : PipeMessageType.ListMutes);
        }
        catch (Exception exception)
        {
            Log.Error(exception, "Error loading mute records (Expired: {Expired})", Expired);
            _records = null;
            _errorMessage = Localizer["ModerationLoadFailed"];
        }
        finally
        {
            _loading = false;
            _busy = false;
        }
    }

    private async Task RemoveAsync(MuteRecord row)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _errorMessage = null;
            await ServerBinding.SendAsync(PipeMessageType.RemoveMute, new RemoveModerationRequest { Id = row.Id });
            await AuditLogger.WriteAsync(AuditActions.UnmutePlayer, row.SteamId, $"Record {row.Id}; {row.Kind}");
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Log.Error(exception, "Error removing mute record {Id}", row.Id);
            _errorMessage = Localizer["ModerationRemoveFailed"];
        }
        finally
        {
            _busy = false;
        }
    }
}
