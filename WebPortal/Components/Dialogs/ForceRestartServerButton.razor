@using CbmrWebAdmin.WebPortal.Data
@inject IConfiguration Configuration
@inject ILogger<ForceRestartServerButton> Logger
<ConfirmDialog @ref="dialog" />

<button class="btn btn-danger" @onclick="ShowConfirmationAsync" disabled="@_busy">@Localizer["ForceRestart"]</button>

@code {
    private ConfirmDialog dialog = default!;
    private bool _busy;

    private async Task ShowConfirmationAsync()
    {
        if (_busy) return;

        string? executable = Configuration["ForceRestart:ExecutablePath"];
        if (string.IsNullOrWhiteSpace(executable))
        {
            ToastService.Notify(new(ToastType.Warning, Localizer["ForceRestartNotConfigured"]));
            return;
        }

        _busy = true;
        try
        {
            bool confirmation = await dialog.ShowAsync(
                title: Localizer["ForceRestartServer"],
                message1: Localizer["ForceRestartDescription"],
                message2: Localizer["DoYouWantProceed"],
                new ConfirmDialogOptions
                {
                    AutoFocusYesButton = false,
                    Dismissable = true,
                    NoButtonText = Localizer["No"],
                    YesButtonText = Localizer["Yes"]
                });

            if (!confirmation) return;

            try
            {
                await ServerProcess.ForceRestartAsync(executable, Configuration["ForceRestart:Arguments"],
                    Configuration["ForceRestart:WorkingDirectory"]);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Force restart failed for {ServerPath}.", executable);
                ToastService.Notify(new(ToastType.Danger, Localizer["ForceRestartFailed"]));
                return;
            }

            await AuditLogger.WriteAsync(AuditActions.ForceRestartServer, executable);
            ToastService.Notify(new(ToastType.Success, Localizer["ForceRestartProcessStarted"]));
        }
        finally
        {
            _busy = false;
        }
    }
}