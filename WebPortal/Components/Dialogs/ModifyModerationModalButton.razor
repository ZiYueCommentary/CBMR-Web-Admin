@using CbmrWebAdmin.Shared.Requests
@using CbmrWebAdmin.WebPortal.Data
@using Serilog

<button type="button" class="btn btn-primary" disabled="@(Disabled || _sending || TimeZone is null)" @onclick="ShowModal">@Localizer["ModifyModeration"]</button>

<Modal @ref="_modal" Title="@Localizer[IsMute ? "ModifyMute" : "ModifyBan"]">
    <BodyTemplate>
        <p>@SteamId</p>
        @if (_errorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }
        <div class="mb-2">@Localizer["ModerationExpiresAt"] <span class="text-muted">(@TimeZone?.Id)</span></div>
        <div class="form-check mb-3">
            <label class="form-check-label">
                <input class="form-check-input" type="checkbox" @bind="_permanent" disabled="@_sending" />
                @Localizer["ModerationPermanent"]
            </label>
        </div>
        @if (!_permanent)
        {
            <div class="d-flex gap-2 align-items-center mb-3">
                <DateInput TValue="DateOnly?" @bind-Value="_date" Disabled="_sending" />
                <TimeInput TValue="TimeOnly?" @bind-Value="_time" Disabled="_sending" />
            </div>
        }
        <label class="form-label">@Localizer["ModerationReason"]</label>
        <TextAreaInput @bind-Value="_reason" Rows="3" Disabled="_sending" Placeholder="@Localizer["ModerationReason"]" />
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Disabled="_sending" @onclick="HideModal">@Localizer["Close"]</Button>
        <Button Color="ButtonColor.Primary" Disabled="@(_sending || InvalidInput)" @onclick="SaveAsync">@Localizer["SaveModeration"]</Button>
    </FooterTemplate>
</Modal>

@code {
    [CascadingParameter] private BrowserTimeZone? TimeZone { get; set; }

    [Parameter] public long Id { get; set; }
    [Parameter, EditorRequired] public string SteamId { get; set; } = null!;
    [Parameter, EditorRequired] public string Reason { get; set; } = null!;
    [Parameter] public DateTime? ExpiresAtUtc { get; set; }
    [Parameter] public bool IsMute { get; set; }
    [Parameter] public MuteRecordKind? Kind { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private Modal _modal = null!;
    private DateOnly? _date;
    private TimeOnly? _time;
    private string? _reason;
    private string? _errorMessage;
    private bool _permanent;
    private bool _sending;
    private bool InvalidInput => string.IsNullOrWhiteSpace(_reason) || (!_permanent && (_date is null || _time is null));

    private async Task ShowModal()
    {
        if (TimeZone is null) return;
        _reason = Reason;
        _permanent = ExpiresAtUtc is null;
        DateTime? localExpiry = ExpiresAtUtc is { } expiry ? TimeZone.FromUtc(expiry) : null;
        _date = localExpiry is { } date ? DateOnly.FromDateTime(date) : null;
        _time = localExpiry is { } time ? TimeOnly.FromDateTime(time) : null;
        _errorMessage = null;
        await _modal.ShowAsync();
    }

    private async Task HideModal() => await _modal.HideAsync();

    private async Task SaveAsync()
    {
        if (_sending || InvalidInput) return;
        DateTime? expiresAtUtc = null;
        if (!_permanent)
        {
            expiresAtUtc = TimeZone?.ToFutureUtc(_date!.Value, _time!.Value);
            if (expiresAtUtc is null)
            {
                _errorMessage = Localizer["InvalidModerationExpiration"];
                return;
            }
        }

        _sending = true;
        _errorMessage = null;
        try
        {
            await ServerBinding.SendAsync(IsMute ? PipeMessageType.UpdateMute : PipeMessageType.UpdateBan,
                new UpdateModerationRequest { Id = Id, Reason = _reason!.Trim(), ExpiresAtUtc = expiresAtUtc });
            await AuditLogger.WriteAsync(IsMute ? AuditActions.ModifyMute : AuditActions.ModifyBan,
                SteamId, $"Record {Id}" + (IsMute ? $"; {Kind}" : "") +
                $"; {(expiresAtUtc is null ? "permanent" : $"until {expiresAtUtc:u}")}: {_reason!.Trim()}");
            await _modal.HideAsync();
            await OnSaved.InvokeAsync();
        }
        catch (Exception exception)
        {
            Log.Error(exception, "Error modifying moderation record {Id} (IsMute: {IsMute})", Id, IsMute);
            _errorMessage = Localizer["ModerationUpdateFailed"];
        }
        finally
        {
            _sending = false;
        }
    }
}
