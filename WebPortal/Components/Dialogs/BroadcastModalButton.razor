@using CbmrWebAdmin.Shared.Requests

<button class="btn btn-primary" @onclick="ShowModal">@Localizer["Broadcast"]</button>

<Modal @ref="_modal" Title="@Localizer["SendBroadcast"]">
    <BodyTemplate>
        <div class="d-flex p-2 align-items-center">
            <CheckboxInput Label="@Localizer["ShowAdminName"]" @bind-Value="_showAdminName"/>
            <TextInput Style="margin-left: 0.25rem" Disabled="@(!_showAdminName)" @bind-Value="@_adminName"
                       Placeholder="@Localizer["AdminName"]"/>
        </div>
        <TextAreaInput @bind-Value="@_message" Rows="3" Disabled="false"
                       Placeholder="@Localizer["BroadcastContent"]"/>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Close</Button>
        <Button Color="ButtonColor.Primary" @onclick="SendBroadcast">Save changes</Button>
    </FooterTemplate>
</Modal>

@code {
    private Modal _modal = null!;
    private bool _showAdminName;
    private string? _adminName;
    private string? _message;

    private async Task ShowModal()
    {
        await _modal.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        await _modal.HideAsync();
    }

    private async Task SendBroadcast()
    {
        await _modal.HideAsync();
        await ServerBinding.SendAsync(PipeMessageType.Boardcast,
            new BroadcastRequest
            {
                Title = _showAdminName ? Localizer["AdminBoardcast", _adminName] : Localizer["ServerBoardcast"],
                Message = _message!
            });
        _message = null;
        ToastService.Notify(new(ToastType.Success, "Succeed!"));
    }

}
