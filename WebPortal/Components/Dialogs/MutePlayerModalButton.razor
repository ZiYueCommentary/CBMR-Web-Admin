@using CbmrWebAdmin.WebPortal.Data
@using CbmrWebAdmin.Shared.Requests
@using Serilog

<button type="button" class="btn btn-warning" disabled="@(_sending || TimeZone is null)" @onclick="ShowModal">@Localizer[ActionKey]</button>

<Modal @ref="_modal" Title="@Localizer[ActionKey]">
    <BodyTemplate>
        <div class="d-flex gap-2 align-items-center mb-3">
            <span>@Player.Name</span>
            <span class="text-muted">@Player.SteamId</span>
        </div>
        <div class="mb-2">@Localizer["MuteUntil"] <span class="text-muted">(@TimeZone?.Id)</span></div>
        <div class="form-check mb-3">
            <label class="form-check-label">
                <input class="form-check-input" type="checkbox" @bind="_permanent" disabled="@_sending" />
                @Localizer["PermanentMute"]
            </label>
        </div>
        @if (!_permanent)
        {
            <div class="d-flex gap-2 align-items-center mb-3">
                <DateInput TValue="DateOnly?" @bind-Value="_muteDate" Disabled="_sending"/>
                <TimeInput TValue="TimeOnly?" @bind-Value="_muteTime" Disabled="_sending"/>
            </div>
        }
        <TextAreaInput @bind-Value="_reason" Rows="3" Disabled="_sending"
                       Placeholder="@Localizer["MuteReason"]"/>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Disabled="_sending" @onclick="OnHideModalClick">@Localizer["Close"]</Button>
        <Button Color="ButtonColor.Primary" Disabled="@(_sending || InvalidInput)"
                @onclick="SendMuteRequest">@Localizer[ActionKey]</Button>
    </FooterTemplate>
</Modal>

@code {
    [CascadingParameter] private BrowserTimeZone? TimeZone { get; set; }

    [Parameter, EditorRequired]
    public WebPlayer Player { get; set; } = null!;

    [Parameter]
    public bool MuteVoice { get; set; }

    private string ActionKey => MuteVoice ? "MuteVoice" : "MuteChat";
    private Modal _modal = null!;
    private DateOnly? _muteDate;
    private TimeOnly? _muteTime;
    private bool _permanent;
    private string? _reason;
    private bool _sending;

    private bool InvalidInput => (!_permanent && (_muteDate is null || _muteTime is null)) || string.IsNullOrWhiteSpace(_reason);

    private async Task SendMuteRequest()
    {
        if (_sending || InvalidInput) return;

        DateTime? expiresAtUtc = null;
        if (!_permanent)
        {
            expiresAtUtc = TimeZone?.ToFutureUtc(_muteDate!.Value, _muteTime!.Value);
            if (expiresAtUtc is null)
            {
                ToastService.Notify(new(ToastType.Warning, Localizer["InvalidMuteExpiration"]));
                return;
            }
        }

        _sending = true;
        try
        {
            await ServerBinding.SendAsync(MuteVoice ? PipeMessageType.MuteVoice : PipeMessageType.MuteChat, new MutePlayerRequest
            {
                SteamId = Player.SteamId,
                PlayerName = Player.Name,
                ExpiresAtUtc = expiresAtUtc,
                Reason = _reason!.Trim()
            });
            await AuditLogger.WriteAsync(MuteVoice ? AuditActions.MuteVoice : AuditActions.MuteChat,
                $"{Player.Name} ({Player.SteamId})",
                $"{(expiresAtUtc is null ? "permanent" : $"until {expiresAtUtc:u}")}: {_reason!.Trim()}");
            await _modal.HideAsync();
            _muteDate = null;
            _muteTime = null;
            _permanent = false;
            _reason = null;
            ToastService.Notify(new(ToastType.Success, Localizer[MuteVoice ? "PlayerVoiceMuted" : "PlayerChatMuted"]));
        }
        catch (Exception exception)
        {
            Log.Error(exception, "Error on muting player {SteamId} ({MuteType})", Player.SteamId, ActionKey);
            ToastService.Notify(new(ToastType.Danger, Localizer["MuteFailed"]));
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task ShowModal()
    {
        await _modal.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        await _modal.HideAsync();
    }
}
