@using CbmrWebAdmin.WebPortal.Data
@using CbmrWebAdmin.Shared.Requests
@using Serilog

<button type="button" class="btn btn-success" disabled="@(_sending || TimeZone is null)" @onclick="ShowModal">@Localizer[Player is null ? "MuteOfflinePlayer" : "Mute"]</button>

<Modal @ref="_modal" Title="@Localizer[Player is null ? "MuteOfflinePlayer" : "MutePlayer"]">
    <BodyTemplate>
        @if (Player is null)
        {
            <div class="mb-3">
                <input class="form-control" type="text" @bind="_steamId" @bind:event="oninput" required maxlength="64"
                       disabled="@_sending" placeholder="@Localizer["SteamIdPlaceholder"]" aria-label="@Localizer["SteamIdPlaceholder"]" />
            </div>
        }
        else
        {
            <div class="d-flex gap-2 align-items-center mb-3">
                <span>@Player.Name</span>
                <span class="text-muted">@Player.SteamId</span>
            </div>
        }
        <div class="mb-2">@Localizer["MuteKind"]</div>
        <div class="d-flex gap-3 mb-3">
            <div class="form-check">
                <label class="form-check-label">
                    <input class="form-check-input" type="checkbox" @bind="_muteChat" disabled="@_sending" />
                    @Localizer["MuteChat"]
                </label>
            </div>
            <div class="form-check">
                <label class="form-check-label">
                    <input class="form-check-input" type="checkbox" @bind="_muteVoice" disabled="@_sending" />
                    @Localizer["MuteVoice"]
                </label>
            </div>
        </div>
        <div class="mb-2">@Localizer["MuteUntil"]</div>
        <div class="form-check mb-3">
            <label class="form-check-label">
                <input class="form-check-input" type="checkbox" @bind="_permanent" disabled="@_sending" />
                @Localizer["PermanentMute"]
            </label>
        </div>
        @if (!_permanent)
        {
            <div class="d-flex gap-2 align-items-center mb-3">
                <DateInput TValue="DateOnly?" @bind-Value="_muteDate" Disabled="_sending"/>
                <TimeInput TValue="TimeOnly?" @bind-Value="_muteTime" Disabled="_sending"/>
            </div>
        }
        <TextAreaInput @bind-Value="_reason" Rows="3" Disabled="_sending"
                       Placeholder="@Localizer["MuteReason"]"/>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Disabled="_sending" @onclick="OnHideModalClick">@Localizer["Close"]</Button>
        <Button Color="ButtonColor.Warning" Disabled="@(_sending || InvalidInput)"
                @onclick="SendMuteRequests">@Localizer["Mute"]</Button>
    </FooterTemplate>
</Modal>

@code {
    [CascadingParameter] private BrowserTimeZone? TimeZone { get; set; }

    [Parameter]
    public WebPlayer? Player { get; set; }

    private Modal _modal = null!;
    private bool _muteChat = true;
    private bool _muteVoice;
    private DateOnly? _muteDate;
    private TimeOnly? _muteTime;
    private bool _permanent;
    private string? _reason;
    private bool _sending;
    private string? _steamId;

    private bool InvalidSteamId => Player is null && (string.IsNullOrWhiteSpace(_steamId) || _steamId.Trim().Length > 64);

    private bool InvalidInput => InvalidSteamId
                                 || (!_muteChat && !_muteVoice)
                                 || (!_permanent && (_muteDate is null || _muteTime is null))
                                 || string.IsNullOrWhiteSpace(_reason);

    private async Task SendMuteRequests()
    {
        if (_sending || InvalidInput) return;

        DateTime? expiresAtUtc = null;
        if (!_permanent)
        {
            expiresAtUtc = TimeZone?.ToFutureUtc(_muteDate!.Value, _muteTime!.Value);
            if (expiresAtUtc is null)
            {
                ToastService.Notify(new(ToastType.Warning, Localizer["InvalidMuteExpiration"]));
                return;
            }
        }

        _sending = true;
        try
        {
            string steamId = Player?.SteamId ?? _steamId!.Trim();
            string reason = _reason!.Trim();
            if (_muteChat && await TrySendMuteAsync(steamId, voice: false, expiresAtUtc, reason))
                _muteChat = false;
            if (_muteVoice && await TrySendMuteAsync(steamId, voice: true, expiresAtUtc, reason))
                _muteVoice = false;

            if (!_muteChat && !_muteVoice)
            {
                await _modal.HideAsync();
                _muteChat = true;
                _muteDate = null;
                _muteTime = null;
                _permanent = false;
                _reason = null;
                _steamId = null;
            }
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task<bool> TrySendMuteAsync(string steamId, bool voice, DateTime? expiresAtUtc, string reason)
    {
        try
        {
            await ServerBinding.SendAsync(voice ? PipeMessageType.MuteVoice : PipeMessageType.MuteChat, new MutePlayerRequest
            {
                SteamId = steamId,
                PlayerName = Player?.Name,
                ExpiresAtUtc = expiresAtUtc,
                Reason = reason
            });
            await AuditLogger.WriteAsync(voice ? AuditActions.MuteVoice : AuditActions.MuteChat,
                Player is null ? steamId : $"{Player.Name} ({steamId})",
                $"{(expiresAtUtc is null ? "permanent" : $"until {expiresAtUtc:u}")}: {reason}");
            ToastService.Notify(new(ToastType.Success, Localizer[voice ? "PlayerVoiceMuted" : "PlayerChatMuted"]));
            return true;
        }
        catch (Exception exception)
        {
            Log.Error(exception, "Error on muting player {SteamId} ({MuteType})", steamId, voice ? "MuteVoice" : "MuteChat");
            ToastService.Notify(new(ToastType.Danger, Localizer["MuteFailed"]));
            return false;
        }
    }

    private async Task ShowModal()
    {
        await _modal.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        await _modal.HideAsync();
    }
}
