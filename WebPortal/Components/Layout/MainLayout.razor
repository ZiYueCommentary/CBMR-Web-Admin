@inherits LayoutComponentBase

<Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://github.com/ZiYueCommentary/CBMR-Web-Admin/" target="_blank">@Localizer["About"]</a>
        </div>

        <article class="content px-4">
            @if (!PipeBackgroundService.ServerBindingPipe.IsConnected)
            {
                <Alert Color="AlertColor.Danger"> <Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>@Localizer["NoConnectionWithServer"]</Alert>
            }

            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["UnhandledError"]
    <a href="." class="reload">@Localizer["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

<ModalProvider />