@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CBMR Web Admin</a>
    </div>
</div>

<input type="checkbox" title="@Localizer["NavigationMenu"]" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon nav-icon-home" aria-hidden="true"></span> @Localizer["Home"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="central-console">
                <span class="nav-icon nav-icon-instant-mix" aria-hidden="true"></span> @Localizer["CentralConsole"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="players">
                <span class="nav-icon nav-icon-groups" aria-hidden="true"></span> @Localizer["Players"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="banned-players">
                <span class="nav-icon nav-icon-block" aria-hidden="true"></span> @Localizer["BannedPlayers"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="muted-players">
                <span class="nav-icon nav-icon-mic-off" aria-hidden="true"></span> @Localizer["MutedPlayers"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="chat">
                <span class="nav-icon nav-icon-chat" aria-hidden="true"></span> @Localizer["ChatBox"]
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="reports">
                        <span class="nav-icon nav-icon-flag" aria-hidden="true"></span> @Localizer["Reports"]
                        <UnhandledReportBadge />
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="announcements">
                        <span class="nav-icon nav-icon-campaign" aria-hidden="true"></span> @Localizer["Announcements"]
                    </NavLink>
                </div>
                @if (context.User.Identity?.Name is not null && context.User.HasClaim("primary-admin", "true"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="accounts">
                            <span class="nav-icon nav-icon-manage-accounts" aria-hidden="true"></span> @Localizer["AccountManagement"]
                        </NavLink>
                    </div>
                }
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="audit-log">
                        <span class="nav-icon nav-icon-fact-check" aria-hidden="true"></span> @Localizer["AuditLog"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <span class="nav-link">
                        <span class="nav-icon nav-icon-person" aria-hidden="true"></span> @context.User.Identity?.Name
                    </span>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken/>
                        <input type="hidden" name="ReturnUrl" value="@_currentUrl"/>
                        <button type="submit" class="nav-link">
                            <span class="nav-icon nav-icon-logout" aria-hidden="true"></span> @Localizer["Logout"]
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="nav-icon nav-icon-login" aria-hidden="true"></span> @Localizer["Login"]
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? _currentUrl;

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}