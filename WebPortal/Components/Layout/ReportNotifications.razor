@implements IDisposable
@inject ServerEvents Events
@inject IJSRuntime JS

<button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" aria-pressed="@_enabled" disabled="@(!_interactive || _changing)" @onclick="ToggleAsync">
    @Localizer[_enabled ? "DisableReportNotifications" : "EnableReportNotifications"]
</button>

<div class="toast-container position-fixed bottom-0 end-0 p-3 overflow-auto" aria-live="polite" aria-relevant="additions">
    @foreach (var toast in _toasts)
    {
        <div class="toast show mw-100" @key="toast">
            <div class="toast-header">
                <strong class="me-auto text-break">@toast.Title</strong>
                <button type="button" class="btn-close flex-shrink-0" aria-label="@Localizer["Close"]" @onclick="() => _toasts.Remove(toast)"></button>
            </div>
            <div class="toast-body text-break">
                <div>@toast.Body</div>
                <a class="d-inline-block mt-2 ms-0" href="reports">@Localizer["Reports"]</a>
            </div>
        </div>
    }
</div>
@code {
    private readonly List<ReportToast> _toasts = [];
    private bool _enabled = true;
    private bool _changing;
    private bool _disposed;
    private bool _interactive;
    private bool _initialChecked;
    private bool _checking;
    protected override void OnInitialized() => Events.ReportsUpdated += OnReport;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _enabled = await JS.InvokeAsync<bool>("reportNotifications.isEnabled");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        _interactive = true;
        StateHasChanged();
        await CheckPendingAsync();
    }
    private async Task ToggleAsync()
    {
        if (_changing) return;
        _changing = true;
        try
        {
            _enabled = !_enabled;
            await JS.InvokeVoidAsync("reportNotifications.setEnabled", _enabled);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        finally { _changing = false; }
    }
    private async Task ShowAsync(string title, string body)
    {
        if (!_interactive || !_enabled || _disposed) return;
        try
        {
            if (!await JS.InvokeAsync<bool>("reportNotifications.isEnabled") || !_enabled || _disposed) return;
            _toasts.Add(new ReportToast(title, body));
            StateHasChanged();
            await JS.InvokeVoidAsync("reportNotifications.playSound");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }
    private void OnReport(ReportRecord? report)
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            await CheckPendingAsync();
            if (report is null) return;
            await ShowAsync(Localizer["NewReport", report.ReporterName, report.ReportedName].Value, report.Content);
        });
    }
    private async Task CheckPendingAsync()
    {
        if (!_interactive || _initialChecked || _checking || _disposed) return;
        _checking = true;
        try
        {
            int count = await ServerBinding.SendAsync<int>(PipeMessageType.CountUnhandledReports);
            if (_disposed) return;
            if (count > 0)
                await ShowAsync(Localizer["PendingReportNotification", count].Value, Localizer["ReviewPendingReports"].Value);
            _initialChecked = true;
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or TimeoutException or InvalidOperationException or IOException)
        {
        }
        finally { _checking = false; }
    }
    public void Dispose() { _disposed = true; Events.ReportsUpdated -= OnReport; }

    private sealed class ReportToast(string title, string body)
    {
        public string Title { get; } = title;
        public string Body { get; } = body;
    }
}
