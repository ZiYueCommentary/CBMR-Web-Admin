@implements IDisposable
@inject ServerEvents Events
@inject IJSRuntime JS

<div class="d-flex align-items-center gap-2">
    <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" aria-pressed="@_enabled" disabled="@(!_interactive || _changing)" @onclick="ToggleAsync">
        @Localizer[_enabled ? "DisableReportNotifications" : "EnableReportNotifications"]
    </button>
    @if (_enabled && _permission == "default")
    {
        <button type="button" class="btn btn-sm btn-link" @onclick="EnableAsync">@Localizer["ReportNotificationPermission"]</button>
    }
    else if (_enabled && _permission is "denied" or "unsupported")
    {
        <small class="text-muted">@Localizer["ReportNotificationsUnavailable"]</small>
    }
</div>
@code {
    private bool _enabled = true;
    private bool _changing;
    private string _permission = "";
    private bool _disposed;
    private bool _interactive;
    private bool _initialChecked;
    private bool _checking;
    protected override void OnInitialized() => Events.ReportsUpdated += OnReport;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _interactive = true;
        try
        {
            _enabled = await JS.InvokeAsync<bool>("reportNotifications.initialize");
            _permission = await JS.InvokeAsync<string>("reportNotifications.permission");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        StateHasChanged();
        await CheckPendingAsync();
    }
    private async Task ToggleAsync()
    {
        if (_changing) return;
        _changing = true;
        try
        {
            _enabled = !_enabled;
            await JS.InvokeVoidAsync("reportNotifications.setEnabled", _enabled);
            _permission = await JS.InvokeAsync<string>("reportNotifications.permission");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        finally { _changing = false; }
    }
    private async Task EnableAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("reportNotifications.enable");
            _permission = await JS.InvokeAsync<string>("reportNotifications.permission");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }
    private void OnReport(ReportRecord? report)
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            await CheckPendingAsync();
            if (report is null) return;
            try { await JS.InvokeVoidAsync("reportNotifications.show", Localizer["NewReport", report.ReporterName, report.ReportedName].Value, report.Content); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        });
    }
    private async Task CheckPendingAsync()
    {
        if (!_interactive || _initialChecked || _checking || _disposed) return;
        _checking = true;
        try
        {
            var reports = await ServerBinding.SendAsync<List<ReportRecord>>(PipeMessageType.ListReports);
            if (_disposed) return;
            int count = reports.Count(report => !report.Handled);
            if (count > 0)
                await JS.InvokeVoidAsync("reportNotifications.show", Localizer["PendingReportNotification", count].Value, Localizer["ReviewPendingReports"].Value);
            _initialChecked = true;
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or TimeoutException or InvalidOperationException or IOException)
        {
        }
        finally { _checking = false; }
    }
    public void Dispose() { _disposed = true; Events.ReportsUpdated -= OnReport; }
}
