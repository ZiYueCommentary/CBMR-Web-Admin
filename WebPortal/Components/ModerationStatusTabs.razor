@using CbmrWebAdmin.Shared.Requests

<ul class="nav nav-tabs mb-3">
    @foreach (var (status, label) in Tabs)
    {
        <li class="nav-item"><button type="button" class="nav-link @(_status == status ? "active" : "")" aria-pressed="@(_status == status)" @onclick="() => _status = status">@Localizer[label]</button></li>
    }
</ul>
<section @key="_status" aria-label="@Localizer[Tabs.First(tab => tab.Status == _status).Label]">
    @ChildContent(_status)
</section>

@code {
    private static readonly (BanStatus Status, string Label)[] Tabs =
    [
        (BanStatus.Active, "BanListStatusActive"), (BanStatus.Expired, "BanListStatusExpired"),
        (BanStatus.Revoked, "BanListStatusRevoked")
    ];

    [Parameter, EditorRequired] public RenderFragment<BanStatus> ChildContent { get; set; } = default!;

    private BanStatus _status = BanStatus.Active;
}
