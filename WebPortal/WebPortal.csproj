<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>aspnet-WebPortal-81c9d08e-0969-4679-9e8f-1725843dec0e</UserSecretsId>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <AssemblyName>CbmrWebAdmin.WebPortal</AssemblyName>
        <RootNamespace>CbmrWebAdmin.WebPortal</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Blazor.Bootstrap" Version="3.5.0" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11"/>
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.1-dev-02312" />
        <PackageReference Include="Serilog.Extensions.Logging.File" Version="9.0.0-dev-02303" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Components\Account\Pages\AccessDenied.razor" />
      <AdditionalFiles Include="Components\Account\Pages\Lockout.razor" />
      <AdditionalFiles Include="Components\Account\Pages\Login.razor" />
      <AdditionalFiles Include="Components\Account\Pages\_Imports.razor" />
      <AdditionalFiles Include="Components\Account\Shared\RedirectToLogin.razor" />
      <AdditionalFiles Include="Components\Account\Shared\StatusMessage.razor" />
      <AdditionalFiles Include="Components\App.razor" />
      <AdditionalFiles Include="Components\Layout\MainLayout.razor" />
      <AdditionalFiles Include="Components\Layout\NavMenu.razor" />
      <AdditionalFiles Include="Components\Pages\Error.razor" />
      <AdditionalFiles Include="Components\Pages\Home.razor" />
      <AdditionalFiles Include="Components\Routes.razor" />
      <AdditionalFiles Include="Components\_Imports.razor" />
      <AdditionalFiles Include="Resources\SharedResource.resx" />
      <AdditionalFiles Include="Resources\SharedResource.zh-Hans.resx" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Resources\SharedResource.cs">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources\SharedResource.resx">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        <DependentUpon>SharedResource.cs</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\SharedResource.resx">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\SharedResource.zh-Hans.resx">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Shared\Shared.csproj" />
    </ItemGroup>

    <Target Name="CopyPortableStaticWebAssets" AfterTargets="CopyStaticWebAssetsToOutputDirectory">
      <ComputeStaticWebAssetsForCurrentProject Assets="@(StaticWebAsset)"
          ProjectMode="$(StaticWebAssetProjectMode)" AssetKind="Build" Source="$(PackageId)">
        <Output TaskParameter="StaticWebAssets" ItemName="_PortableStaticWebAssets" />
      </ComputeStaticWebAssetsForCurrentProject>

      <ComputeStaticWebAssetsTargetPaths Assets="@(_PortableStaticWebAssets)" PathPrefix="wwwroot">
        <Output TaskParameter="AssetsWithTargetPath" ItemName="_PortableStaticWebAssetsWithTargetPath" />
      </ComputeStaticWebAssetsTargetPaths>

      <Copy SourceFiles="@(_PortableStaticWebAssetsWithTargetPath)"
          DestinationFiles="@(_PortableStaticWebAssetsWithTargetPath->'$(OutDir)%(TargetPath)')"
          SkipUnchangedFiles="true">
        <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
      </Copy>
    </Target>

</Project>
