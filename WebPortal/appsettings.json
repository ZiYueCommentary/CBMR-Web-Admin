{
    "ConnectionStrings": {
        "DefaultConnection": "DataSource=Data/webadmin.db;Cache=Shared"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "CbmrWebAdmin.WebPortal": "Information",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://*:5000"
            }
        }
    },
    "AllowedHosts": "*",
    "PipeReconnectDelaySeconds": 5
}
